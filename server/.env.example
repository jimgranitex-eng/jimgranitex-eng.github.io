# Silvius affiliate + email server — copy to .env on the host. NEVER commit real values.
# Affiliate pivot 2026-10-10: no Stripe, no POD. We route, merchants sell.

# Resend (transactional email for double opt-in + sequence). His tap.
RESEND_API_KEY={{RESEND_API_KEY}}
FROM_EMAIL=James <hello@silvius.world>

# Public base URL of this service (used in email links)
BASE_URL=https://jimgranitex-eng-github-io.onrender.com

# Admin key for GET /api/export?key=... (CSV download). Pick a long random string.
ADMIN_KEY={{ADMIN_KEY}}

# Allowed CORS origins (comma-separated). Static sites live on GitHub Pages + silvius.world.
ALLOWED_ORIGINS=https://jimgranitex-eng.github.io,https://go.silvius.world

# Optional overrides for email links (defaults point at the kitchen funnel)
FREE_PACK_URL=https://go.silvius.world/kitchen/
TRIPWIRE_URL=https://go.silvius.world/kitchen/#tripwire
BUNDLE_URL=https://go.silvius.world/kitchen/#bundle

# SQLite path (defaults to ./email.db next to server.js). JSON fallback is automatic.
DB_PATH=./email.db
