# Silvius store server — copy to .env and fill from his taps. NEVER commit .env.
# Stripe (his taps: dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY={{STRIPE_SECRET_KEY}}
STRIPE_WEBHOOK_SECRET={{STRIPE_WEBHOOK_SECRET}}
STRIPE_PUBLISHABLE_KEY={{STRIPE_PUBLISHABLE_KEY}}
# Print-on-demand (his taps: Printful and/or Printify API keys from his accounts)
PRINT_PROVIDER=printful
PRINTFUL_API_KEY={{PRINTFUL_API_KEY}}
PRINTIFY_API_TOKEN={{PRINTIFY_API_TOKEN}}
PRINTIFY_SHOP_ID={{PRINTIFY_SHOP_ID}}
# Storefront origins allowed to call the session endpoint (CORS)
ALLOWED_ORIGINS=https://shop.silvius.world,https://prints.silvius.world
# Support / notifications
SUPPORT_EMAIL={{SUPPORT_EMAIL}}
COMPANY_NAME={{COMPANY_NAME}}
PORT=8787
